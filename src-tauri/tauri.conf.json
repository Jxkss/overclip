{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Overclip",
  "version": "0.1.0",
  "identifier": "com.overclip.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Overclip",
        "width": 1280,
        "height": 720,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "url": "index.html#/overlay"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "startMenuFolder": "Overclip"
      }
    },
    "publisher": "Jxkss",
    "homepage": "https://jxkss.github.io/overclip/",
    "copyright": "Copyright (c) 2026 Jxkss. Released under the MIT License.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "In-game overlay for your game clips and screenshots",
    "longDescription": "Overclip is a free, open-source overlay for Windows. Press a shortcut in any game to browse, preview, share and tidy up your clips and screenshots."
  },
  "plugins": {}
}
